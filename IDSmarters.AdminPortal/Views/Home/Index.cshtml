@{
    ViewData["Title"] = "Home Page";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />

<style>
    .home-container {
        background: url('/images/school.png') no-repeat center center;
        background-size: cover;
        min-height: 100vh;
        display: flex;
        justify-content: center;
        align-items: center;
        color: #fff;
        text-shadow: 1px 1px 2px #000;
        padding: 50px;
    }

    .home-box {
        background-color: rgba(0, 100, 0, 0.75);
        padding: 40px;
        border-radius: 12px;
        max-width: 650px;
        text-align: center;
        box-shadow: 0 0 12px rgba(0,0,0,0.3);
    }

        .home-box h1 {
            font-weight: bold;
            font-size: 2.5rem;
        }

        .home-box p {
            font-size: 1.2rem;
        }

    .btn-learn {
        margin-top: 20px;
        background-color: #ffffff;
        color: #006400;
        border: none;
        padding: 10px 20px;
        font-weight: bold;
    }

        .btn-learn:hover {
            background-color: #f1f1f1;
            color: #004d00;
        }
</style>

<div class="home-container">
    <div class="home-box">
        <h1>Welcome to Infotech Development Systems Colleges</h1>
        <p>Your future starts here. Build your career and learn modern web technologies like ASP.NET Core.</p>
        <a class="btn btn-learn" href="https://learn.microsoft.com/aspnet/core" target="_blank">
            Learn More
        </a>
    </div>
</div>
